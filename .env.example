# Copy to .env.local (git-ignored) and fill in real values.
# Validated at boot by apps/web/lib/env.ts — see instrumentation.ts.

# Database
DATABASE_URL=

# Email (Resend) — apps/web/lib/notify.ts
RESEND_API_KEY=
RFQ_NOTIFY_TO=
RFQ_NOTIFY_FROM=

# Storage (R2/S3-compatible) — apps/web/lib/presign.ts
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Public (exposed to the browser)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
